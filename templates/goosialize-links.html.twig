<!doctype html>
<html lang="{{ grav.language.language|default('en')|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >
    <meta name="color-scheme" content="light dark">

    <title>
        {{- goosialize_links.page_title|e -}}
    </title>

    <link
        rel="stylesheet"
        href="{{ url('plugin://goosialize-links/assets/css/goosialize-links.css')|e('html_attr') }}"
    >
</head>
<body
    data-theme="{{ goosialize_links.appearance.theme|e('html_attr') }}"
    data-accent="{{ goosialize_links.appearance.accent|e('html_attr') }}"
>
    <main
        class="goosialize-links"
        data-goosialize-links-page
        data-theme="{{ goosialize_links.appearance.theme|e('html_attr') }}"
        data-accent="{{ goosialize_links.appearance.accent|e('html_attr') }}"
        data-button-shape="{{ goosialize_links.appearance.button_shape|e('html_attr') }}"
    >
        <section
            class="goosialize-links__profile"
            aria-labelledby="goosialize-links-name"
        >
            <div class="goosialize-links__avatar">
                {% if goosialize_links.profile.image_stream %}
                    <img
                        class="goosialize-links__avatar-image"
                        data-goosialize-links-profile-image
                        src="{{ url(goosialize_links.profile.image_stream)|e('html_attr') }}"
                        alt=""
                    >
                {% else %}
                    <span aria-hidden="true">
                        {{- goosialize_links.profile.initial|e -}}
                    </span>
                {% endif %}
            </div>

            {% if goosialize_links.profile.name %}
                <h1
                    id="goosialize-links-name"
                    class="goosialize-links__name"
                >
                    {{ goosialize_links.profile.name|e }}
                </h1>
            {% endif %}

            {% if goosialize_links.profile.title %}
                <p class="goosialize-links__title">
                    {{ goosialize_links.profile.title|e }}
                </p>
            {% endif %}

            {% if goosialize_links.profile.description %}
                <p class="goosialize-links__description">
                    {{ goosialize_links.profile.description|e|nl2br }}
                </p>
            {% endif %}

            {% if goosialize_links.profile.website_url %}
                <a
                    class="goosialize-links__website"
                    href="{{ goosialize_links.profile.website_url|e('html_attr') }}"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Website
                </a>
            {% endif %}
        </section>

        {% if goosialize_links.actions %}
            <nav
                class="goosialize-links__actions"
                aria-label="Social and contact actions"
            >
                {% for action in goosialize_links.actions %}
                    <a
                        class="goosialize-links__action"
                        data-goosialize-action
                        data-action-id="{{ action.id|e('html_attr') }}"
                        data-action-type="{{ action.type|e('html_attr') }}"
                        href="{{ action.href|e('html_attr') }}"
                        aria-label="{{ action.label|e('html_attr') }}"
                        {% if action.new_tab %}
                            target="_blank"
                            rel="noopener noreferrer"
                        {% endif %}
                    >
                        {{- action.label|e -}}
                    </a>
                {% endfor %}
            </nav>
        {% endif %}

        {% if goosialize_links.links %}
            <nav
                class="goosialize-links__list"
                aria-label="Links"
            >
                {% for link in goosialize_links.links %}
                    <a
                        class="goosialize-links__link"
                        data-goosialize-link
                        data-link-id="{{ link.id|e('html_attr') }}"
                        href="{{ link.url|e('html_attr') }}"
                        {% if link.new_tab %}
                            target="_blank"
                            rel="noopener noreferrer"
                        {% endif %}
                    >
                        <span>
                            {{- link.title|e -}}
                        </span>

                        <span
                            class="goosialize-links__arrow"
                            aria-hidden="true"
                        >
                            {% if link.new_tab %}
                                ↗
                            {% else %}
                                →
                            {% endif %}
                        </span>
                    </a>
                {% endfor %}
            </nav>
        {% endif %}

        <footer class="goosialize-links__footer">
            <a
                class="goosialize-links__powered"
                data-goosialize-links-powered-by
                href="{{ goosialize_links.powered_by.url|e('html_attr') }}"
                target="_blank"
                rel="noopener noreferrer"
            >
                {{ goosialize_links.powered_by.label|e }}
            </a>
        </footer>
    </main>
</body>
</html>
